{
  "name": "homelabcore-web",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && npm run build:css && node scripts/build-headers.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "test:urls": "node scripts/check-urls.mjs",
    "test:html": "html-validate \"dist/**/*.html\"",
    "test:a11y": "node scripts/check-a11y.mjs",
    "test": "npm run test:urls && npm run test:html && npm run test:meta && npm run test:headers && npm run test:a11y && npm run test:theme && npm run test:budget",
    "test:theme": "node scripts/check-theme.mjs",
    "test:budget": "node scripts/check-budget.mjs",
    "test:meta": "node scripts/check-meta.mjs",
    "og": "node scripts/og/render-og.mjs",
    "build:css": "esbuild dist/assets/css/styles.css --minify --outfile=dist/assets/css/styles.css --allow-overwrite --log-level=warning",
    "test:headers": "node scripts/check-headers.mjs"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@types/node": "^22.20.5",
    "astro": "^7.3.5",
    "esbuild": "^0.28.2",
    "html-validate": "^11.16.2",
    "playwright": "1.63.0",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3"
  }
}
