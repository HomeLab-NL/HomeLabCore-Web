---
import BaseLayout from "./BaseLayout.astro";
import ProductPageBar, { type ProductTab } from "../components/ProductPageBar.astro";
import type { RouteKey } from "../data/routes";
import type { Project } from "../lib/projects";
import type { Locale } from "../i18n/locales";

// Pages that belong to one project: overview, privacy policy, support.
// Applies the project accent, adds the breadcrumb + product sub-nav, and
// highlights the project's section in the global nav.
interface Props {
  project: Project;
  tab: ProductTab;
  route: RouteKey;
  title: string;
  description: string;
  ogTitle?: string;
  ogDescription?: string;
  ogType?: "website" | "article";
  lang?: Locale;
}

const { project, tab, lang = "en", ...meta } = Astro.props;
const navSection = tab === "support" ? "support" : project.data.section;
---
<BaseLayout {...meta} lang={lang} project={project.id} navSection={navSection}>
  <ProductPageBar slot="pagebar" project={project} tab={tab} lang={lang} />
  <slot />
</BaseLayout>
