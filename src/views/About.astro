---
import { Picture } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import { CONTACT } from "../data/site";
import { href, type Locale } from "../i18n/locales";
import { ui } from "../i18n/ui";
import logo from "../assets/brand/homelab-logo-web.png";

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;
const COPY = {
  en: {
    title: "About — HomeLabCore",
    description: "HomeLabCore is a small independent software studio that builds and maintains a short list of focused apps and experiments.",
    og: "A small independent software studio that builds and maintains a short list of focused apps and experiments.",
    h1: "About HomeLabCore",
    lead: "HomeLabCore is a small, independent software studio. It designs, builds, and maintains a short list of focused apps rather than a large catalogue.",
    body: "The aim is straightforward: make practical software for everyday problems, keep it maintained, and be clear about how it handles your data. Alongside the apps, the lab is where experiments, games and AI workflow benchmarks live.",
    name: "HomeLabCore is the name these apps are published under.",
    logoAlt: "HomeLab logo: a laboratory flask with a code symbol, above the wordmark homelab and the tagline we code ideas",
    contact: "Contact",
    support: "Support",
    privacy: "Privacy",
    help: "App help",
    helpLink: "Support pages for each app",
  },
  nl: {
    title: "Over ons — HomeLabCore",
    description: "HomeLabCore is een kleine, onafhankelijke softwarestudio die een korte lijst gerichte apps en experimenten bouwt en onderhoudt.",
    og: "Een kleine, onafhankelijke softwarestudio die een korte lijst gerichte apps en experimenten bouwt en onderhoudt.",
    h1: "Over HomeLabCore",
    lead: "HomeLabCore is een kleine, onafhankelijke softwarestudio. Ze ontwerpt, bouwt en onderhoudt een korte lijst gerichte apps in plaats van een grote catalogus.",
    body: "Het doel is eenvoudig: praktische software maken voor alledaagse problemen, die onderhouden, en duidelijk zijn over hoe ze met je gegevens omgaat. Naast de apps is het lab de plek voor experimenten, games en benchmarks van AI-workflows.",
    name: "HomeLabCore is de naam waaronder deze apps worden uitgebracht.",
    logoAlt: "HomeLab-logo: een laboratoriumkolf met een codesymbool, boven het woordmerk homelab en de slogan we code ideas",
    contact: "Contact",
    support: "Support",
    privacy: "Privacy",
    help: "Hulp bij apps",
    helpLink: "Supportpagina's per app (Engels)",
  },
  uk: {
    title: "Про нас — HomeLabCore",
    description: "HomeLabCore — невелика незалежна студія програмного забезпечення, яка створює й підтримує короткий перелік зосереджених застосунків та експериментів.",
    og: "Невелика незалежна студія, яка створює й підтримує короткий перелік зосереджених застосунків та експериментів.",
    h1: "Про HomeLabCore",
    lead: "HomeLabCore — невелика незалежна студія програмного забезпечення. Вона проєктує, створює й підтримує короткий перелік зосереджених застосунків, а не великий каталог.",
    body: "Мета проста: робити практичне ПЗ для щоденних задач, підтримувати його і чесно пояснювати, як воно поводиться з вашими даними. Поруч із застосунками є лабораторія — для експериментів, ігор і бенчмарків AI-процесів.",
    name: "HomeLabCore — це назва, під якою публікуються ці застосунки.",
    logoAlt: "Логотип HomeLab: лабораторна колба із символом коду над написом homelab і слоганом we code ideas",
    contact: "Контакти",
    support: "Підтримка",
    privacy: "Конфіденційність",
    help: "Допомога із застосунками",
    helpLink: "Сторінки підтримки для кожного застосунку (англійською)",
  },
}[lang];
const nav = ui(lang).nav;
---
<BaseLayout route="about" lang={lang} title={COPY.title} description={COPY.description} ogDescription={COPY.og} navCurrent="about">
  <section class="section">
    <div class="container split">
      <div class="measure">
        <span class="eyebrow">{nav.about}</span>
        <h1>{COPY.h1}</h1>
        <p class="lead">{COPY.lead}</p>
        <p>{COPY.body}</p>
        <p>{COPY.name}</p>
        <ul class="link-list">
          <li><a href={href("/apps/", lang)}>{nav.apps}</a></li>
          <li><a href={href("/lab/", lang)}>{nav.lab}</a></li>
          <li><a href={href("/benchmarks/", lang)}>{nav.benchmarks}</a></li>
        </ul>
      </div>
      <figure class="fig about-logo">
        <Picture src={logo} alt={COPY.logoAlt} widths={[220, 440]} sizes="220px" formats={["avif"]} fallbackFormat="webp" />
      </figure>
    </div>
  </section>

  <section class="section" aria-labelledby="contact-title">
    <div class="container">
      <h2 id="contact-title">{COPY.contact}</h2>
      <dl class="meta-list measure">
        <dt>{COPY.support}</dt>
        <dd><a href={`mailto:${CONTACT.support}`}>{CONTACT.support}</a></dd>
        <dt>{COPY.privacy}</dt>
        <dd><a href={`mailto:${CONTACT.privacy}`}>{CONTACT.privacy}</a></dd>
        <dt>{COPY.help}</dt>
        <dd><a href="/support/" hreflang={lang !== "en" ? "en" : undefined}>{COPY.helpLink}</a></dd>
      </dl>
    </div>
  </section>
</BaseLayout>
