---
import ProductLayout from "../layouts/ProductLayout.astro";
import ProjectGallery from "./ProjectGallery.astro";
import ProjectHero from "./ProjectHero.astro";
import { routeForPath } from "../data/routes";
import type { Project } from "../lib/projects";

// Generic overview page for projects without a hand-written page. It shows
// only what the project entry states; missing information is listed openly.
interface Props {
  project: Project;
}

const { project } = Astro.props;
const { name, summary, kind, missing, urls } = project.data;
---
<ProductLayout
  project={project}
  tab="overview"
  route={routeForPath(urls.overview)}
  title={`${name} — HomeLabCore`}
  description={summary}
>
  <ProjectHero project={project} eyebrow={kind} title={name} lead={summary} />

  <ProjectGallery project={project} index={1} />

  {missing.length > 0 && (
    <section class="section section--tight">
      <div class="container">
        <div class="panel panel--note measure">
          <h2>More information coming</h2>
          <p class="muted">{name} is a work in progress, and this page only states what has been confirmed so far. Still to come:</p>
          <ul class="muted">
            {missing.map((m) => <li>{m}</li>)}
          </ul>
          <p class="small">Questions in the meantime: <a href="mailto:support@homelabcore.dev">support@homelabcore.dev</a>.</p>
        </div>
      </div>
    </section>
  )}
</ProductLayout>
