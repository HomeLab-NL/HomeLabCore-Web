---
import ProductLayout from "../layouts/ProductLayout.astro";
import ProjectGallery from "./ProjectGallery.astro";
import ProjectHero from "./ProjectHero.astro";
import SectionHead from "./SectionHead.astro";
import { routeForPath } from "../data/routes";
import { CONTACT } from "../data/site";
import { localizeProject, type Project } from "../lib/projects";
import type { Locale } from "../i18n/locales";
import { ui } from "../i18n/ui";

// Generic overview page for projects without a hand-written page. It shows
// only what the project entry states; missing information is listed openly.
interface Props {
  /** The English entry; texts are localized here. */
  project: Project;
  lang?: Locale;
}

const { lang = "en" } = Astro.props;
const enUrl = Astro.props.project.data.urls.overview;
const project = localizeProject(Astro.props.project, lang);
const { name, summary, kind, missing, urls, features, contextNote } = project.data;
const t = ui(lang).project;
const galleryIndex = features && features.length > 0 ? 2 : 1;
---
<ProductLayout
  project={project}
  tab="overview"
  route={routeForPath(enUrl)}
  lang={lang}
  title={`${name} — HomeLabCore`}
  description={summary}
>
  <ProjectHero project={project} eyebrow={kind} title={name} lead={summary} lang={lang}>
    {(urls.live || urls.repo) && (
      <div class="btn-row">
        {urls.live && <a class="btn btn--primary" href={urls.live} rel="noopener noreferrer">{t.openLive}</a>}
        {urls.repo && <a class="btn btn--ghost" href={urls.repo} rel="noopener noreferrer">{t.viewSource}</a>}
      </div>
    )}
  </ProjectHero>

  {features && features.length > 0 && (
    <section class="section" aria-labelledby="features-title">
      <div class="container">
        <SectionHead index={1} label={t.featuresLabel} title={t.featuresTitle(name)} id="features-title" />
        <dl class="features">
          {features.map((f) => (
            <div>
              <dt>{f.title}</dt>
              <dd>{f.description}</dd>
            </div>
          ))}
        </dl>
      </div>
    </section>
  )}

  <ProjectGallery project={project} index={galleryIndex} lang={lang} />

  {contextNote && (
    <section class="section section--tight" aria-labelledby="context-title">
      <div class="container">
        <div class="panel panel--note measure">
          <h2 id="context-title">{t.contextTitle}</h2>
          <p class="muted">{contextNote}</p>
        </div>
      </div>
    </section>
  )}

  {missing.length > 0 && (
    <section class="section section--tight">
      <div class="container">
        <div class="panel panel--note measure">
          <h2>{t.moreTitle}</h2>
          <p class="muted">{t.moreIntro(name)}</p>
          <ul class="muted">
            {missing.map((m) => <li>{m}</li>)}
          </ul>
          <p class="small">{t.questions} <a href={`mailto:${CONTACT.support}`}>{CONTACT.support}</a>.</p>
        </div>
      </div>
    </section>
  )}
</ProductLayout>
