---
import { CONTACT } from "../data/site";
import { projectsIn } from "../lib/projects";

const apps = await projectsIn("apps");
const lab = await projectsIn("lab");
const legal = apps.filter((p) => p.data.urls.privacy);
---
<footer class="site-footer">
  <div class="container">
    <div class="footer-top">
      <div>
        <p class="footer-brand">
          <img class="footer-brand__mark brand__mark--light" src="/assets/brand/homelab-flask-mark.png" width="18" height="28" alt="">
          <img class="footer-brand__mark brand__mark--dark" src="/assets/brand/homelab-flask-mark-dark.png" width="18" height="28" alt="">
          <span>HomeLab<span class="brand__core">Core</span></span>
        </p>
        <p class="footer-desc">An independent software lab: apps, experiments, games and AI benchmarks.</p>
      </div>
      <nav class="footer-grid" aria-label="Footer">
        <div class="footer-col">
          <h2>Apps</h2>
          <ul>
            {apps.map((p) => <li><a href={p.data.urls.overview}>{p.data.name}</a></li>)}
          </ul>
        </div>
        <div class="footer-col">
          <h2>Lab</h2>
          <ul>
            {lab.map((p) => <li><a href={p.data.urls.overview}>{p.data.name}</a></li>)}
            <li><a href="/benchmarks/">Benchmarks</a></li>
          </ul>
        </div>
        <div class="footer-col">
          <h2>Privacy</h2>
          <ul>
            {legal.map((p) => <li><a href={p.data.urls.privacy}>{p.data.name}</a></li>)}
          </ul>
        </div>
        <div class="footer-col">
          <h2>Studio</h2>
          <ul>
            <li><a href="/about">About</a></li>
            <li><a href="/support/">Support</a></li>
            <li><a href={`mailto:${CONTACT.support}`}>{CONTACT.support}</a></li>
            <li><a href={`mailto:${CONTACT.privacy}`}>{CONTACT.privacy}</a></li>
          </ul>
        </div>
      </nav>
    </div>
    <div class="footer-copy">
      <span>&copy; <span data-year>2026</span> HomeLabCore</span>
      <span>we code ideas</span>
    </div>
  </div>
</footer>
