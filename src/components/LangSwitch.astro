---
import { LOCALES, LOCALE_INFO, TRANSLATED_PATHS, localizedPath, type Locale } from "../i18n/locales";
import { ui } from "../i18n/ui";

// Language menu next to the theme button: a native <details> disclosure, so
// it works without JS and by keyboard. Each item opens this page in that
// language; pages that exist only in English (privacy, support) offer the
// other languages' home pages instead and say so.
interface Props {
  lang: Locale;
  /** English path of the current page. */
  path: string;
}
const { lang, path } = Astro.props;
const translated = TRANSLATED_PATHS.has(path);
const t = ui(lang);
const target = (l: Locale) => (translated ? localizedPath(path, l) : localizedPath(l === "en" ? path : "/", l));
---
<details class="lang-switch" data-lang-switch>
  <summary class="lang-switch__button">
    <span aria-hidden="true">{LOCALE_INFO[lang].short}</span>
    <span class="visually-hidden">{t.language}: {LOCALE_INFO[lang].name}</span>
    <svg viewBox="0 0 12 12" aria-hidden="true"><path d="M2.5 4.5 6 8l3.5-3.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
  </summary>
  <ul class="lang-switch__menu">
    {LOCALES.map((l) => (
      <li>
        <a href={target(l)} hreflang={LOCALE_INFO[l].hreflang} lang={LOCALE_INFO[l].hreflang} aria-current={l === lang ? "true" : undefined}>
          <span class="lang-switch__short" aria-hidden="true">{LOCALE_INFO[l].short}</span>
          <span>{LOCALE_INFO[l].name}</span>
        </a>
      </li>
    ))}
    {!translated && <li class="lang-switch__note">{t.languageEnglishOnly}</li>}
  </ul>
</details>
