---
import Figure from "./Figure.astro";
import SectionHead from "./SectionHead.astro";
import type { Project } from "../lib/projects";

interface Props {
  project: Project;
  index?: number;
  /** First figure number (the hero is Fig. 01). */
  start?: number;
}

const { project, index, start = 2 } = Astro.props;
const { name, figures } = project.data;
const allScreens = figures.every((f) => f.kind === "composition" || f.kind === "screenshot");
---
{figures.length > 0 && (
  <section class="section" aria-labelledby="gallery-title">
    <div class="container">
      <SectionHead index={index} label="Gallery" title={allScreens ? `${name} screens` : `${name} visuals`} id="gallery-title">
        Select an image to open it at full size.
      </SectionHead>
      <div class="gallery">
        {figures.map((f, i) => (
          <Figure
            number={start + i}
            image={f.src}
            alt={f.alt}
            caption={f.caption}
            kind={f.kind}
            sizes="(min-width: 1160px) 545px, (min-width: 720px) 50vw, 100vw"
            zoom
          />
        ))}
      </div>
    </div>
  </section>
)}
