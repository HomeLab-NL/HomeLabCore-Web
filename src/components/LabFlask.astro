---
import { allProjects } from "../lib/projects";

// Homepage hero illustration: the HomeLabCore flask, animated. Liquid waves
// and rising bubbles = "we build things"; the graduated scale beside it =
// "then measure how we built them". The projects float beside the flask as
// labels (names from the content collection — no invented data). Inline SVG +
// CSS only, theme tokens and project accents for colour; static when the
// visitor prefers reduced motion.

const projects = await allProjects();

const CHIP = { x: 352, w: 200, y0: 22, gap: 10 };
let y = CHIP.y0;
const chips = projects.map((p, i) => {
  const name = p.data.name;
  // Long names wrap onto two lines so the text stays large on small screens.
  const split = name.length > 18 ? name.lastIndexOf(" ", Math.ceil(name.length / 2) + 2) : -1;
  const lines = split > 0 ? [name.slice(0, split), name.slice(split + 1)] : [name];
  const h = lines.length === 1 ? 40 : 58;
  const chip = { id: p.id, lines, y, h, i };
  y += h + CHIP.gap;
  return chip;
});

const bubbles = [
  { x: 120, r: 7, d: 0 },
  { x: 168, r: 5, d: 1.1 },
  { x: 214, r: 8, d: 2.3 },
  { x: 142, r: 4, d: 3.0 },
  { x: 238, r: 5, d: 0.6 },
  { x: 188, r: 6, d: 1.8 },
];
const steam = [
  { x: 168, r: 6, d: 0.4, dx: -14 },
  { x: 182, r: 4, d: 1.6, dx: 10 },
  { x: 175, r: 5, d: 2.8, dx: -4 },
];
const ticks = Array.from({ length: 11 }, (_, i) => 172 + i * 19);

// Flask outline (Erlenmeyer): neck 152–198, body widening to the base.
const body = "M152,44 V150 L64,342 Q56,364 82,364 H268 Q294,364 286,342 L198,150 V44";
const desc = `Animated illustration: a laboratory flask with bubbling blue liquid beside a measuring scale, next to the names of HomeLabCore projects: ${projects.map((p) => p.data.name).join(", ")}.`;
---
<figure class="lab-flask">
  <svg class="lab-flask__svg" viewBox="0 0 560 400" role="img" aria-labelledby="lab-flask-title lab-flask-desc">
    <title id="lab-flask-title">Build, then measure</title>
    <desc id="lab-flask-desc">{desc}</desc>
    <defs>
      <clipPath id="lf-inside"><path d={`${body} Z`} /></clipPath>
      <linearGradient id="lf-liquid" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" class="lf-stop-top" />
        <stop offset="1" class="lf-stop-bottom" />
      </linearGradient>
    </defs>

    <g class="lf-flask">
      <path class="lf-glass" d={`${body} Z`} />
      <g clip-path="url(#lf-inside)">
        <g class="lf-level">
          <path class="lf-wave lf-wave--back" d="M0,236 q20,-10 40,0 t40,0 t40,0 t40,0 t40,0 t40,0 t40,0 t40,0 t40,0 V420 H0 Z" />
          <path class="lf-wave lf-wave--front" d="M0,240 q20,-8 40,0 t40,0 t40,0 t40,0 t40,0 t40,0 t40,0 t40,0 t40,0 V420 H0 Z" fill="url(#lf-liquid)" />
          {bubbles.map((b) => (
            <circle class="lf-bubble" cx={b.x} cy="356" r={b.r} style={`--d:${b.d}s`} />
          ))}
        </g>
      </g>
      <path class="lf-outline" d={body} />
      <path class="lf-rim" d="M140,44 H210" />
      {steam.map((s) => (
        <circle class="lf-steam" cx={s.x} cy="132" r={s.r} style={`--d:${s.d}s;--dx:${s.dx}px`} />
      ))}
    </g>

    <g class="lf-scale">
      <path class="lf-scale__axis" d="M312,166 V364" />
      {ticks.map((t, i) => (
        <path class="lf-scale__tick" d={`M312,${t} h${i % 5 === 0 ? 14 : 8}`} />
      ))}
      <path class="lf-scale__marker" d="M304,238 l-10,-7 v14 z" />
    </g>

    {chips.map((c) => (
      <g class="lf-chip" data-project={c.id} style={`--i:${c.i}`}>
        <rect class="lf-chip__box" x={CHIP.x} y={c.y} width={CHIP.w} height={c.h} rx="12" />
        <circle class="lf-chip__dot" cx={CHIP.x + 20} cy={c.y + 20} r="6" />
        {c.lines.map((line, j) => (
          <text class="lf-chip__name" x={CHIP.x + 36} y={c.y + 25 + j * 19}>{line}</text>
        ))}
      </g>
    ))}
  </svg>
</figure>
