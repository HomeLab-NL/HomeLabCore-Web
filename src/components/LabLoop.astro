---
import { allProjects, statusLabel } from "../lib/projects";

// Homepage hero figure: an animated schematic of how the lab works — every
// project is built, and the build is then measured. Pure inline SVG + CSS (no
// JS); colours come from theme tokens and project accents, so it follows the
// light/dark theme. Honest by construction: project names and statuses come
// from the content collection, and the benchmark panel is empty until real
// results are published. With reduced motion the schematic is static.

const projects = await allProjects();

const NODE = { x: 16, w: 236, h: 44, y0: 40, step: 56 };
const HUB = { cx: 316, cy: 200, r: 28 };
const nodes = projects.map((p, i) => {
  const y = NODE.y0 + i * NODE.step;
  const my = y + NODE.h / 2;
  const x1 = NODE.x + NODE.w;
  const x2 = HUB.cx - HUB.r;
  return {
    id: p.id,
    name: p.data.name,
    status: statusLabel(p.data.status),
    y,
    my,
    path: `M${x1},${my} C${x1 + 22},${my} ${x2 - 22},${HUB.cy} ${x2},${HUB.cy}`,
  };
});
const out = `M${HUB.cx + HUB.r},${HUB.cy} L372,${HUB.cy}`;
const desc =
  `Schematic: ${nodes.map((n) => `${n.name} (${n.status.toLowerCase()})`).join(", ")} ` +
  "feed into the lab, and the lab feeds into benchmarks, which have no published results yet.";
---
<figure class="fig lab-loop">
  <div class="fig__frame lab-loop__frame">
    <svg class="lab-loop__svg" viewBox="0 0 520 380" role="img" aria-labelledby="lab-loop-title lab-loop-desc">
      <title id="lab-loop-title">How the lab works: build, then measure</title>
      <desc id="lab-loop-desc">{desc}</desc>

      <text class="ll-head" x="16" y="24">Build</text>
      <text class="ll-head" x="372" y="24">Measure</text>

      {nodes.map((n, i) => (
        <g data-project={n.id}>
          <path class="ll-link" d={n.path} pathLength="100" style={`--i:${i}`} />
          <path class="ll-pulse" d={n.path} pathLength="100" style={`--i:${i}`} />
          <rect class="ll-node" x={NODE.x} y={n.y} width={NODE.w} height={NODE.h} rx="8" />
          <circle class="ll-dot" cx={NODE.x + 18} cy={n.my} r="5" />
          <text class="ll-name" x={NODE.x + 32} y={n.y + 20}>{n.name}</text>
          <text class="ll-status" x={NODE.x + 32} y={n.y + 35}>{n.status}</text>
        </g>
      ))}

      <path class="ll-link" d={out} pathLength="100" style="--i:6" />
      <path class="ll-pulse ll-pulse--out" d={out} pathLength="100" />

      <g class="ll-hub">
        <circle class="ll-hub__ring" cx={HUB.cx} cy={HUB.cy} r={HUB.r + 8} />
        <circle class="ll-hub__core" cx={HUB.cx} cy={HUB.cy} r={HUB.r} />
        <path
          class="ll-flask"
          d={`M${HUB.cx - 6},${HUB.cy - 15} h12 M${HUB.cx - 4},${HUB.cy - 15} v9 l-9,15 a3,3 0 0 0 3,4 h20 a3,3 0 0 0 3,-4 l-9,-15 v-9`}
        />
        <path class="ll-liquid" d={`M${HUB.cx - 11},${HUB.cy + 7} h22 l2,2 a3,3 0 0 1 -3,4 h-20 a3,3 0 0 1 -3,-4 z`} />
      </g>

      <g class="ll-bench">
        <rect class="ll-node" x="372" y="118" width="132" height="164" rx="8" />
        <text class="ll-name" x="386" y="142">Benchmarks</text>
        <path class="ll-axis" d="M392,156 V250 H492" />
        <line class="ll-sweep" x1="396" y1="158" x2="396" y2="248" />
        <text class="ll-status" x="442" y="273" text-anchor="middle">no results yet</text>
      </g>
    </svg>
  </div>
  <figcaption class="fig__caption">
    <span class="meta">Fig. 01 —</span>
    <span>How the lab works: every project is built, then measured. Benchmarks are in preparation.</span>
  </figcaption>
</figure>
