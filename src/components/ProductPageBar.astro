---
import type { Project } from "../lib/projects";

export type ProductTab = "overview" | "privacy" | "support";

interface Props {
  project: Project;
  tab: ProductTab;
}

const { project, tab } = Astro.props;
const { name, urls, section } = project.data;
const sectionLabel = section === "apps" ? "Apps" : "Lab";

const TABS = (
  [
    { key: "overview", label: "Overview", href: urls.overview },
    { key: "privacy", label: "Privacy Policy", href: urls.privacy },
    { key: "support", label: "Support", href: urls.support },
  ] as { key: ProductTab; label: string; href?: string }[]
).filter((t) => t.href);
const currentLabel = TABS.find((t) => t.key === tab)!.label;
---
<div class="pagebar">
  <div class="container">
    <nav class="crumbs" aria-label="Breadcrumb">
      <ol>
        <li><a href="/">HomeLabCore</a></li>
        <li><a href={`/${section}/`}>{sectionLabel}</a></li>
        {tab === "overview" ? (
          <li aria-current="page">{name}</li>
        ) : (
          <>
            <li><a href={urls.overview}>{name}</a></li>
            <li aria-current="page">{currentLabel}</li>
          </>
        )}
      </ol>
    </nav>
    {TABS.length > 1 && (
      <nav class="subnav" aria-label={`${name} pages`}>
        {TABS.map((t) => (
          <a href={t.href} aria-current={t.key === tab ? "page" : undefined}>{t.label}</a>
        ))}
      </nav>
    )}
  </div>
</div>
