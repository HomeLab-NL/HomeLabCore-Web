---
import type { CollectionEntry } from "astro:content";

export type ProductTab = "overview" | "privacy" | "support";

interface Props {
  app: CollectionEntry<"apps">;
  tab: ProductTab;
}

const { app, tab } = Astro.props;
const { name, urls } = app.data;

const TABS: { key: ProductTab; label: string }[] = [
  { key: "overview", label: "Overview" },
  { key: "privacy", label: "Privacy Policy" },
  { key: "support", label: "Support" },
];
const currentLabel = TABS.find((t) => t.key === tab)!.label;
---
<div class="pagebar">
  <div class="container">
    <nav class="crumbs" aria-label="Breadcrumb">
      <ol>
        <li><a href="/">HomeLabCore</a></li>
        <li><a href="/apps/">Apps</a></li>
        {tab === "overview" ? (
          <li aria-current="page">{name}</li>
        ) : (
          <>
            <li><a href={urls.overview}>{name}</a></li>
            <li aria-current="page">{currentLabel}</li>
          </>
        )}
      </ol>
    </nav>
    <nav class="subnav" aria-label={`${name} pages`}>
      {TABS.map((t) => (
        <a href={urls[t.key]} aria-current={t.key === tab ? "page" : undefined}>{t.label}</a>
      ))}
    </nav>
  </div>
</div>
