---
import Figure from "./Figure.astro";
import ProjectMeta from "./ProjectMeta.astro";
import type { Project } from "../lib/projects";
import type { Locale } from "../i18n/locales";
import { ui } from "../i18n/ui";

// Project page header: title, lead and metadata, then the project's lead
// image full width (or a marked placeholder), with its provenance note.
interface Props {
  project: Project;
  eyebrow: string;
  title: string;
  lead: string;
  lang?: Locale;
}

const { project, eyebrow, title, lead, lang = "en" } = Astro.props;
const { name, hero, visualNote } = project.data;
---
<section class="project-hero">
  <div class="container">
    <div class="project-hero__grid">
      <div>
        <span class="eyebrow">{eyebrow}</span>
        <h1>{title}</h1>
        <p class="lead">{lead}</p>
        <slot />
      </div>
      <ProjectMeta project={project} lang={lang} />
    </div>
    <div class="project-hero__figure">
      {hero ? (
        <Figure
          image={hero.src}
          alt={hero.alt}
          caption={hero.caption}
          kind={hero.kind}
          sizes="(min-width: 1160px) 1100px, 100vw"
          loading="eager"
          zoom
          lang={lang}
        />
      ) : (
        <Figure caption={name} missing={ui(lang).project.noVisuals(name)} lang={lang} />
      )}
      {visualNote && hero && <p class="visual-note">{visualNote}</p>}
    </div>
  </div>
</section>
