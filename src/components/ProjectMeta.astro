---
import type { Project } from "../lib/projects";
import { platformLabel } from "../lib/projects";
import Status from "./Status.astro";
import type { Locale } from "../i18n/locales";
import { ui } from "../i18n/ui";

interface Props {
  project: Project;
  lang?: Locale;
}
const { project, lang = "en" } = Astro.props;
const t = ui(lang).meta;
const pLabel = ui(lang).platform;
const { kind, status, workingTitle, version, releaseDate, platformStatus, urls } = project.data;
---
<dl class="meta-list">
  <dt>{t.status}</dt>
  <dd><Status status={status} lang={lang} /></dd>
  <dt>{t.type}</dt>
  <dd>{kind}</dd>
  <dt>{t.platform}</dt>
  <dd>{platformLabel(project, lang)}</dd>
  {version && (
    <>
      <dt>{t.version}</dt>
      <dd>{version}</dd>
    </>
  )}
  {releaseDate && (
    <>
      <dt>{t.releaseDate}</dt>
      <dd><time datetime={releaseDate}>{releaseDate}</time></dd>
    </>
  )}
  {platformStatus && platformStatus.map((ps) => (
    <>
      <dt>{pLabel[ps.platform] ?? ps.platform}</dt>
      <dd>{ps.status}</dd>
    </>
  ))}
  {workingTitle && (
    <>
      <dt>{t.workingTitle}</dt>
      <dd>{workingTitle}</dd>
    </>
  )}
  {urls.live && (
    <>
      <dt>{t.liveUrl}</dt>
      <dd><a href={urls.live} rel="noopener noreferrer">{urls.live.replace(/^https?:\/\//, "").replace(/\/$/, "")}</a></dd>
    </>
  )}
  {urls.googlePlay && (
    <>
      <dt>Google Play</dt>
      <dd><a href={urls.googlePlay} rel="noopener noreferrer">play.google.com/store/apps/details?id=com.homelabnl.recipeai</a></dd>
    </>
  )}
</dl>
