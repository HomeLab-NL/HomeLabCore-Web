---
import { Picture, getImage } from "astro:assets";
import type { ImageMetadata } from "astro";

// A captioned figure: "Fig. 01 — Caption · composed from real app screens".
// Pass `image` for a real asset, or omit it and pass `missing` to render a
// clearly marked placeholder. Anything else can be passed in the slot (for
// example an HTML illustration).
export type FigureKind = "screenshot" | "composition" | "illustration" | "diagram" | "concept" | "promo";

// Concept art and promotional artwork carry a visible marker: they must never
// read as screenshots of the product. Other kinds are described by the caption.
const BADGES: Partial<Record<FigureKind, string>> = {
  concept: "Concept art · Not gameplay",
  promo: "Promotional artwork",
};

interface Props {
  number?: number;
  caption: string;
  kind?: FigureKind;
  image?: ImageMetadata;
  alt?: string;
  /** What visual is missing, for the placeholder text. */
  missing?: string;
  widths?: number[];
  sizes?: string;
  loading?: "eager" | "lazy";
  /** Link the image to a full-size copy, for detailed compositions and diagrams. */
  zoom?: boolean;
  class?: string;
}

const {
  number,
  caption,
  kind,
  image,
  alt = "",
  missing,
  widths = [480, 800, 1200, 1600],
  sizes = "(min-width: 960px) 50vw, 100vw",
  loading = "lazy",
  zoom = false,
  class: className,
} = Astro.props;

const label = number !== undefined ? `Fig. ${String(number).padStart(2, "0")}` : undefined;
const hasSlot = Astro.slots.has("default");
const full = image && zoom ? await getImage({ src: image, format: "webp", width: image.width }) : undefined;
const pictureWidths = image ? widths.filter((w) => w <= image.width) : [];
---
<figure class:list={["fig", { "fig--illustration": kind === "illustration" && image }, className]}>
  <div class="fig__frame">
    {image ? (
      full ? (
        <a class="fig__zoom" href={full.src}>
          <Picture src={image} alt={alt} widths={pictureWidths} sizes={sizes} formats={["avif"]} fallbackFormat="webp" loading={loading} decoding="async" />
          <span class="visually-hidden">(open full-size image)</span>
        </a>
      ) : (
        <Picture src={image} alt={alt} widths={pictureWidths} sizes={sizes} formats={["avif"]} fallbackFormat="webp" loading={loading} decoding="async" />
      )
    ) : hasSlot ? (
      <slot />
    ) : (
      <div class="placeholder">
        <span class="placeholder__label">Placeholder</span>
        <span class="placeholder__text">{missing ?? "Visual not available yet."}</span>
      </div>
    )}
  </div>
  <figcaption class="fig__caption">
    {kind && BADGES[kind] && <span class="badge">{BADGES[kind]}</span>}
    {label && <span class="meta">{label} —</span>}
    <span>{caption}</span>
    {!image && !hasSlot && <span class="meta">· placeholder</span>}
  </figcaption>
</figure>
