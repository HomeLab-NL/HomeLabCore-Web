---
import { getEntry } from "astro:content";
import ProductLayout from "../../../layouts/ProductLayout.astro";

const app = (await getEntry("apps", "ops-planner"))!;
---
<ProductLayout
  app={app}
  tab="overview"
  route="opsPlanner"
  title="Ops Planner — Plan your team's week"
  description="Ops Planner is an Android app for distributing a department's tasks, duties, and events among employees across the week. All data stays on your device — no account, no server."
  ogDescription="Distribute a department's tasks, duties, and events among employees across the week. Local-only: no account, no server."
>
  <section class="hero">
    <div class="container hero__grid">
      <div>
        <p class="eyebrow">Ops Planner</p>
        <h1 class="hero__title">Plan your team's week.</h1>
        <p class="lead">Ops Planner helps you share out a department's tasks, duties, and events among employees, day by day. Drag a task onto a person, see everyone's workload at a glance, and send each person their schedule.</p>
        <div class="btn-row">
          <a class="btn btn--primary" href="/support/ops-planner/">Get support</a>
          <a class="btn btn--ghost" href="/privacy/ops-planner/">Privacy Policy</a>
        </div>
      </div>

      <div class="appcard" role="img" aria-label="Ops Planner preview: a task from the pool is dragged onto an employee for Monday, and their workload updates.">
        <div class="appcard__head"><span class="appcard__dot" aria-hidden="true"></span> Ops Planner</div>
        <p class="appcard__label">Pool</p>
        <div class="chips" aria-hidden="true">
          <span class="chip">📋 Weekly stock check</span>
          <span class="chip">🛎 Front-desk duty</span>
          <span class="chip">📅 Team meeting</span>
        </div>
        <div class="appflow" aria-hidden="true">
          <span class="appflow__arrow">↓</span>
          <div class="appstep">
            <p class="appcard__label" style="margin:0 0 .2rem;">Employee · Monday</p>
            Anna — Weekly stock check
          </div>
          <span class="appflow__arrow">↓</span>
          <div class="appstep appstep--accent">
            <p class="appcard__label" style="margin:0 0 .2rem;">Workload</p>
            Anna · 75% of working hours
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">How it works</p>
        <h2>From a list of work to a weekly plan</h2>
      </div>

      <div class="grid grid--3">
        <div class="card">
          <h3>1. Add your team</h3>
          <p class="muted">Enter employees with their position, department, working days and hours, email address, and vacation periods.</p>
        </div>
        <div class="card">
          <h3>2. Build the pool</h3>
          <p class="muted">Create the recurring work of your department as tasks, duties, and events, with estimated hours and times.</p>
        </div>
        <div class="card">
          <h3>3. Assign and share</h3>
          <p class="muted">Drag items onto employees for a day or the whole week, then email each person their schedule or send a workload report to the manager.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--tight">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Features</p>
        <h2>What Ops Planner includes</h2>
      </div>

      <div class="grid grid--2">
        <div class="card">
          <h3>Drag-and-drop weekly planning</h3>
          <p class="muted">Assign a task, duty, or event to an employee for one day, the whole working week, or any set of days you pick. The same item can go to several people.</p>
        </div>
        <div class="card">
          <h3>Workload at a glance</h3>
          <p class="muted">Each employee shows a workload percentage calculated from assigned hours and their own working schedule, so over- and under-loaded people stand out.</p>
        </div>
        <div class="card">
          <h3>Employees, departments &amp; schedules</h3>
          <p class="muted">Keep employees grouped by department, with individual working days, hours, and breaks.</p>
        </div>
        <div class="card">
          <h3>Vacations &amp; public holidays</h3>
          <p class="muted">Record vacation periods — the planner won't assign work to someone who is away. Public holidays for Ukraine or the Netherlands are marked on the calendar.</p>
        </div>
        <div class="card">
          <h3>Task status &amp; transfer</h3>
          <p class="muted">Mark assigned tasks as done or in progress, and transfer an assignment to another employee for one day or the whole week.</p>
        </div>
        <div class="card">
          <h3>Share schedules by email</h3>
          <p class="muted">Send an employee their schedule for a day or the week. Ops Planner prepares the message and opens it in your own email app for you to review and send.</p>
        </div>
        <div class="card">
          <h3>Excel workload report</h3>
          <p class="muted">Generate an .xlsx report of assignments and workload for the selected days and attach it to an email to the manager, again through your own email app.</p>
        </div>
        <div class="card">
          <h3>Export &amp; import</h3>
          <p class="muted">Save a full copy of your data to a JSON file wherever you choose, and restore it later — for example when moving to a new phone.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="showcase">
        <div>
          <span class="showcase__badge">Local-first</span>
          <h3>Your plan stays on your phone</h3>
          <p class="showcase__tagline">No account. No server.</p>
          <p class="muted">Everything you enter in Ops Planner is stored only on your device. There is no sign-up, no cloud sync, no advertising, and no analytics. Data leaves the device only when you choose to send an email or export a file.</p>
          <ul class="tag-list">
            <li>No account needed</li>
            <li>No ads or tracking</li>
            <li>Ukrainian, English, Dutch</li>
            <li>Light &amp; dark theme</li>
          </ul>
        </div>
        <div class="appcard">
          <div class="appcard__head" aria-hidden="true"><span class="appcard__dot"></span> Ops Planner</div>
          <p class="appcard__label" aria-hidden="true">Your data</p>
          <div class="appflow" role="img" aria-label="Where Ops Planner data lives: on the device, and only in an email or export file when you choose to send or save one.">
            <div class="appstep appstep--accent">Stored on this device</div>
            <span class="appflow__arrow">↓</span>
            <div class="appstep">Only when you choose: email via your mail app, or an export file</div>
          </div>
          <p class="muted" style="font-size: 0.82rem; margin: 0.9rem 0 0;">Read the <a href="/privacy/ops-planner/">Privacy Policy</a>.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--tight">
    <div class="container">
      <div class="card">
        <h3>Availability</h3>
        <p class="muted">Ops Planner is built for Android and is currently in testing on Google Play. A store link will be added here once the listing is public. For help in the meantime, visit <a href="/support/ops-planner/">Ops Planner Support</a> or email <a href="mailto:support@homelabcore.dev">support@homelabcore.dev</a>.</p>
      </div>
    </div>
  </section>
</ProductLayout>
