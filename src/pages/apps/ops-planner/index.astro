---
import { getEntry } from "astro:content";
import ProductLayout from "../../../layouts/ProductLayout.astro";
import ProjectGallery from "../../../components/ProjectGallery.astro";
import ProjectHero from "../../../components/ProjectHero.astro";
import SectionHead from "../../../components/SectionHead.astro";

const project = (await getEntry("projects", "ops-planner"))!;
---
<ProductLayout
  project={project}
  tab="overview"
  route="opsPlanner"
  title="Ops Planner — Plan your team's week"
  description="Ops Planner is an Android app for distributing a department's tasks, duties, and events among employees across the week. All data stays on your device — no account, no server."
  ogDescription="Distribute a department's tasks, duties, and events among employees across the week. Local-only: no account, no server."
>
  <ProjectHero
    project={project}
    eyebrow="Ops Planner"
    title="Plan your team's week."
    lead="Ops Planner helps you share out a department's tasks, duties, and events among employees, day by day. Drag a task onto a person, see everyone's workload at a glance, and send each person their schedule."
  >
    <div class="btn-row">
      <a class="btn btn--primary" href="/support/ops-planner/">Get support</a>
      <a class="btn btn--ghost" href="/privacy/ops-planner/">Privacy Policy</a>
    </div>
  </ProjectHero>

  <section class="section" aria-labelledby="how-title">
    <div class="container">
      <SectionHead index={1} label="How it works" title="From a list of work to a weekly plan" id="how-title" />
      <ol class="steps">
        <li>
          <h3>Add your team</h3>
          <p>Enter employees with their position, department, working days and hours, email address, and vacation periods.</p>
        </li>
        <li>
          <h3>Build the pool</h3>
          <p>Create the recurring work of your department as tasks, duties, and events, with estimated hours and times.</p>
        </li>
        <li>
          <h3>Assign and share</h3>
          <p>Drag items onto employees for a day or the whole week, then email each person their schedule or send a workload report to the manager.</p>
        </li>
      </ol>
    </div>
  </section>

  <section class="section" aria-labelledby="features-title">
    <div class="container">
      <SectionHead index={2} label="Features" title="What Ops Planner includes" id="features-title" />
      <dl class="features">
        <div><dt>Drag-and-drop weekly planning</dt><dd>Assign a task, duty, or event to an employee for one day, the whole working week, or any set of days you pick. The same item can go to several people.</dd></div>
        <div><dt>Workload at a glance</dt><dd>Each employee shows a workload percentage calculated from assigned hours and their own working schedule, so over- and under-loaded people stand out.</dd></div>
        <div><dt>Employees, departments &amp; schedules</dt><dd>Keep employees grouped by department, with individual working days, hours, and breaks.</dd></div>
        <div><dt>Vacations &amp; public holidays</dt><dd>Record vacation periods — the planner won't assign work to someone who is away. Public holidays for Ukraine or the Netherlands are marked on the calendar.</dd></div>
        <div><dt>Task status &amp; transfer</dt><dd>Mark assigned tasks as done or in progress, and transfer an assignment to another employee for one day or the whole week.</dd></div>
        <div><dt>Share schedules by email</dt><dd>Send an employee their schedule for a day or the week. Ops Planner prepares the message and opens it in your own email app for you to review and send.</dd></div>
        <div><dt>Excel workload report</dt><dd>Generate an .xlsx report of assignments and workload for the selected days and attach it to an email to the manager, again through your own email app.</dd></div>
        <div><dt>Export &amp; import</dt><dd>Save a full copy of your data to a JSON file wherever you choose, and restore it later — for example when moving to a new phone.</dd></div>
      </dl>
    </div>
  </section>

  <section class="section" aria-labelledby="local-title">
    <div class="container split">
      <div>
        <span class="eyebrow">03 / Local-first</span>
        <h2 id="local-title">Your plan stays on your phone</h2>
        <p class="lead">No account. No server.</p>
        <p class="muted">Everything you enter in Ops Planner is stored only on your device. There is no sign-up, no cloud sync, no advertising, and no analytics. Data leaves the device only when you choose to send an email or export a file.</p>
        <ul class="tag-list">
          <li>No account needed</li>
          <li>No ads or tracking</li>
          <li>Ukrainian, English, Dutch</li>
          <li>Light &amp; dark theme</li>
        </ul>
      </div>
      <div class="panel panel--note">
        <p class="meta">Your data</p>
        <ol class="steps steps--plain">
          <li><h3>Stored on this device</h3></li>
          <li><h3>Only when you choose: email via your mail app, or an export file</h3></li>
        </ol>
        <p class="muted small">Read the <a href="/privacy/ops-planner/">Privacy Policy</a>.</p>
      </div>
    </div>
  </section>

  <ProjectGallery project={project} index={4} />

  <section class="section section--tight" aria-labelledby="availability-title">
    <div class="container">
      <div class="panel measure">
        <h2 id="availability-title">Availability</h2>
        <p class="muted">Ops Planner is built for Android and is currently in testing on Google Play. A store link will be added here once the listing is public. For help in the meantime, visit <a href="/support/ops-planner/">Ops Planner Support</a> or email <a href="mailto:support@homelabcore.dev">support@homelabcore.dev</a>.</p>
      </div>
    </div>
  </section>
</ProductLayout>
