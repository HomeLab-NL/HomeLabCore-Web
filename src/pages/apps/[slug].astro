---
import type { GetStaticPaths } from "astro";
import ProjectPage from "../../components/ProjectPage.astro";
import { projectsIn, type Project } from "../../lib/projects";

export const getStaticPaths = (async () => {
  // Apps without a hand-written page (CookFrom and Ops Planner have their own).
  const HAND_WRITTEN = new Set(["cookfrom", "ops-planner"]);
  return (await projectsIn("apps"))
    .filter((p) => !HAND_WRITTEN.has(p.id))
    .map((project) => ({ params: { slug: project.id }, props: { project } }));
}) satisfies GetStaticPaths;

const { project } = Astro.props as { project: Project };
---
<ProjectPage project={project} />
