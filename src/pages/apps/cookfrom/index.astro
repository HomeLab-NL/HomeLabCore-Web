---
import { getEntry } from "astro:content";
import ProductLayout from "../../../layouts/ProductLayout.astro";
import Figure from "../../../components/Figure.astro";
import ProjectMeta from "../../../components/ProjectMeta.astro";
import SectionHead from "../../../components/SectionHead.astro";

const project = (await getEntry("projects", "cookfrom"))!;
const { cover, figures } = project.data;
---
<ProductLayout
  project={project}
  tab="overview"
  route="cookfrom"
  title="CookFrom — Cook with what you already have"
  description="CookFrom is a cooking assistant that helps you cook from ingredients you already have: choose or photograph ingredients, get AI-assisted recipes, and manage a pantry, shopping list, and favorites."
  ogDescription="A cooking assistant that helps you cook from ingredients you already have, with AI-assisted recipes, a pantry, shopping list, and favorites."
>
  <section class="project-hero">
    <div class="container project-hero__grid">
      <div>
        <span class="eyebrow">CookFrom</span>
        <h1>Cook with what you already have.</h1>
        <p class="lead">Pick the ingredients in your kitchen or scan them from a photo. CookFrom drafts an AI-assisted recipe you can adjust, save, and cook from step by step.</p>
        <ProjectMeta project={project} />
        <div class="btn-row">
          <a class="btn btn--primary" href="/support/cookfrom">Get support</a>
          <a class="btn btn--ghost" href="/privacy/cookfrom">Privacy Policy</a>
        </div>
      </div>
      <Figure number={1} caption="How CookFrom works: ingredients, recipe, cooking mode" kind="illustration">
        <div class="mock" role="img" aria-label="CookFrom preview: selected ingredients lead to an AI-assisted recipe, then to step-by-step cooking mode.">
          <div class="mock__head" aria-hidden="true">CookFrom</div>
          <div aria-hidden="true">
            <p class="mock__label">Ingredients you have</p>
            <div class="chips">
              <span class="chip">🍅 Tomato</span>
              <span class="chip">🧅 Onion</span>
              <span class="chip">🥚 Eggs</span>
              <span class="chip">🧀 Cheese</span>
            </div>
            <div class="mock__flow">
              <span class="mock__arrow">↓</span>
              <div class="mock__step">
                <p class="mock__label">Recipe</p>
                Tomato &amp; onion frittata · 4 servings
              </div>
              <span class="mock__arrow">↓</span>
              <div class="mock__step mock__step--accent">
                <p class="mock__label">Cooking mode</p>
                Step 1 of 6 — Warm the pan
              </div>
            </div>
          </div>
        </div>
      </Figure>
    </div>
  </section>

  <section class="section" aria-labelledby="how-title">
    <div class="container">
      <SectionHead index={1} label="How it works" title="From ingredients to a recipe" id="how-title" />
      <ol class="steps">
        <li>
          <h3>Choose ingredients</h3>
          <p>Select the ingredients you already have, or point your camera at them and let CookFrom recognize ingredients from a photo.</p>
        </li>
        <li>
          <h3>Generate a recipe</h3>
          <p>CookFrom uses AI-assisted recipe generation to suggest something you can make, taking your dietary preferences and allergies into account.</p>
        </li>
        <li>
          <h3>Cook and adjust</h3>
          <p>Adjust servings, edit the recipe, and switch to Cooking Mode to follow the steps while you work.</p>
        </li>
      </ol>
    </div>
  </section>

  <section class="section" aria-labelledby="features-title">
    <div class="container">
      <SectionHead index={2} label="Features" title="What CookFrom includes" id="features-title" />
      <dl class="features">
        <div><dt>Ingredients &amp; photo recognition</dt><dd>Choose ingredients from a list, or recognize ingredients from a photo to build your selection faster.</dd></div>
        <div><dt>AI-assisted recipe generation</dt><dd>Turn your selected ingredients into a recipe suggestion, then regenerate or refine it.</dd></div>
        <div><dt>Pantry &amp; inventory</dt><dd>Keep track of what is in your kitchen so recipe suggestions match what you actually have.</dd></div>
        <div><dt>Shopping list</dt><dd>Collect the items you still need into a shopping list you can take to the store.</dd></div>
        <div><dt>Favorites &amp; recipe history</dt><dd>Save recipes you like and look back at ones you generated before.</dd></div>
        <div><dt>Dietary preferences &amp; allergies</dt><dd>Set dietary preferences, allergies, and dislikes so recipes are drafted with them in mind.</dd></div>
        <div><dt>Servings adjustment &amp; recipe editing</dt><dd>Scale a recipe up or down for the number of people you are cooking for, and edit the details to suit you.</dd></div>
        <div><dt>Cooking Mode</dt><dd>Follow a recipe step by step in a view designed for use while you cook.</dd></div>
      </dl>
    </div>
  </section>

  <section class="section" aria-labelledby="look-title">
    <div class="container">
      <SectionHead index={3} label="Illustrations" title="The look of the app" id="look-title">
        Dishes in CookFrom are shown with the app's own near-realistic 3D illustrations. App screenshots will follow when the store listing is public.
      </SectionHead>
      <div class="gallery">
        {cover && <Figure number={2} image={cover.src} alt={cover.alt} caption={cover.caption} kind={cover.kind} sizes="(min-width: 960px) 33vw, 100vw" />}
        {figures.map((f, i) => (
          <Figure number={i + 3} image={f.src} alt={f.alt} caption={f.caption} kind={f.kind} sizes="(min-width: 960px) 25vw, 100vw" />
        ))}
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="pro-title">
    <div class="container split">
      <div>
        <span class="eyebrow">04 / CookFrom Pro</span>
        <h2 id="pro-title">A little more, when you need it</h2>
        <p class="lead">Optional, not required.</p>
        <p class="muted">CookFrom Pro is optional. It provides additional AI usage and access to selected premium and experimental AI capabilities.</p>
        <ul class="tag-list">
          <li>Additional AI usage</li>
          <li>Premium and experimental AI capabilities</li>
        </ul>
        <p class="muted small">Pro is offered as a Google Play subscription; your Pro status is tied to your purchase and verified through Google Play.</p>
      </div>
      <div class="panel panel--note">
        <p class="meta">Core workflow</p>
        <ol class="steps steps--plain">
          <li><h3>Choose ingredients</h3></li>
          <li><h3>Generate a recipe</h3></li>
          <li><h3>Cook step by step</h3></li>
        </ol>
        <p class="muted small">Available without a subscription.</p>
      </div>
    </div>
  </section>

  <section class="section section--tight" aria-labelledby="availability-title">
    <div class="container">
      <div class="panel measure">
        <h2 id="availability-title">Availability</h2>
        <p class="muted">CookFrom is built for Android. Store links will be added here once the listing is public. For help in the meantime, visit <a href="/support/cookfrom">CookFrom Support</a>.</p>
      </div>
    </div>
  </section>
</ProductLayout>
