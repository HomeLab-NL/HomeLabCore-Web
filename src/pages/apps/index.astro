---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import SectionHead from "../../components/SectionHead.astro";
import { projectsIn } from "../../lib/projects";

const apps = await projectsIn("apps");
---
<BaseLayout
  route="apps"
  title="Apps — HomeLabCore"
  description="Apps by HomeLabCore: CookFrom, Ops Planner, AI Tutor and Keyboard Trainer — Android and web apps in testing and in development."
  ogDescription="Android and web apps by HomeLabCore."
  navCurrent="apps"
>
  <section class="section">
    <div class="container">
      <SectionHead label="Apps" title="Apps" level="h1">
        Android and web apps by HomeLabCore. Released apps get a product page, a privacy policy and a support page.
      </SectionHead>
      <div class="card-grid card-grid--2">
        {apps.map((p) => <ProjectCard project={p} headingLevel="h2" sizes="(min-width: 720px) 50vw, 100vw" />)}
      </div>
    </div>
  </section>
</BaseLayout>
