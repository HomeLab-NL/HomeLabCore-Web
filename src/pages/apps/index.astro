---
import { getCollection } from "astro:content";
import AppCard from "../../components/AppCard.astro";
import ComingSoonCard from "../../components/ComingSoonCard.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";

const apps = (await getCollection("apps")).sort((a, b) => a.data.order - b.data.order);
---
<BaseLayout
  route="apps"
  title="Apps — HomeLabCore"
  description="Software published by HomeLabCore: CookFrom and Ops Planner, with more in development."
  ogDescription="Software published by HomeLabCore."
  navCurrent="apps"
>
  <section class="section">
    <div class="container">
      <div class="section-head">
        <p class="eyebrow">Apps</p>
        <h1>Apps</h1>
        <p class="lead">Software published by HomeLabCore.</p>
      </div>

      <div class="app-grid">
        {apps.map((app) => (
          <AppCard app={app} href={app.data.urls.overview} description={app.data.cards.apps} />
        ))}
        <ComingSoonCard />
      </div>
    </div>
  </section>
</BaseLayout>
