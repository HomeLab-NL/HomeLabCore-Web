---
import BaseLayout from "../../layouts/BaseLayout.astro";
---
<BaseLayout
  route="about"
  title="About — HomeLabCore"
  description="HomeLabCore is a small independent software studio that builds and maintains a short list of focused apps."
  ogDescription="A small independent software studio that builds and maintains a short list of focused apps."
  navCurrent="about"
>
  <section class="section">
    <div class="container narrow">
      <div class="section-head">
        <p class="eyebrow">About</p>
        <h1>About HomeLabCore</h1>
      </div>

      <p>HomeLabCore is a small, independent software studio. It designs, builds, and maintains a short list of focused apps rather than a large catalogue.</p>
      <p>The aim is straightforward: make practical software for everyday problems, keep it maintained, and be clear about how it handles your data. Every app has its own product page, privacy policy, and support page.</p>
      <p>HomeLabCore is the name these apps are published under. Questions are welcome at <a href="mailto:privacy@homelabcore.dev">privacy@homelabcore.dev</a> or <a href="mailto:support@homelabcore.dev">support@homelabcore.dev</a>.</p>
      <p><a href="/apps/">See the apps <span aria-hidden="true">&rarr;</span></a></p>
    </div>
  </section>

  <section class="section section--tight">
    <div class="container">
      <div class="brandband">
        <div class="brandband__logo">
          <picture>
            <source srcset="/assets/brand/homelab-logo-web.webp" type="image/webp">
            <img src="/assets/brand/homelab-logo-web.png" width="560" height="560" alt="HomeLab logo: a laboratory flask with a code symbol, above the wordmark homelab and the tagline we code ideas">
          </picture>
        </div>
        <div class="brandband__text">
          <p>&ldquo;We code ideas.&rdquo; HomeLabCore builds small, useful software and looks after it.</p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
