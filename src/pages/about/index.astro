---
import { Picture } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { CONTACT } from "../../data/site";
import logo from "../../assets/brand/homelab-logo-web.png";
---
<BaseLayout
  route="about"
  title="About — HomeLabCore"
  description="HomeLabCore is a small independent software studio that builds and maintains a short list of focused apps and experiments."
  ogDescription="A small independent software studio that builds and maintains a short list of focused apps and experiments."
  navCurrent="about"
>
  <section class="section">
    <div class="container split">
      <div class="measure">
        <span class="eyebrow">About</span>
        <h1>About HomeLabCore</h1>
        <p class="lead">HomeLabCore is a small, independent software studio. It designs, builds, and maintains a short list of focused apps rather than a large catalogue.</p>
        <p>The aim is straightforward: make practical software for everyday problems, keep it maintained, and be clear about how it handles your data. Alongside the apps, the lab is where experiments, games and AI workflow benchmarks live.</p>
        <p>HomeLabCore is the name these apps are published under.</p>
        <ul class="link-list">
          <li><a href="/apps/">Apps</a></li>
          <li><a href="/lab/">Lab</a></li>
          <li><a href="/benchmarks/">Benchmarks</a></li>
        </ul>
      </div>
      <figure class="fig about-logo">
        <Picture src={logo} alt="HomeLab logo: a laboratory flask with a code symbol, above the wordmark homelab and the tagline we code ideas" widths={[220, 440]} sizes="220px" formats={["avif"]} fallbackFormat="webp" />
      </figure>
    </div>
  </section>

  <section class="section" aria-labelledby="contact-title">
    <div class="container">
      <h2 id="contact-title">Contact</h2>
      <dl class="meta-list measure">
        <dt>Support</dt>
        <dd><a href={`mailto:${CONTACT.support}`}>{CONTACT.support}</a></dd>
        <dt>Privacy</dt>
        <dd><a href={`mailto:${CONTACT.privacy}`}>{CONTACT.privacy}</a></dd>
        <dt>App help</dt>
        <dd><a href="/support/">Support pages for each app</a></dd>
      </dl>
    </div>
  </section>
</BaseLayout>
