---
import type { GetStaticPaths } from "astro";
import AppsIndex from "../../../views/AppsIndex.astro";
import { TRANSLATED_LOCALES, type Locale } from "../../../i18n/locales";

export const getStaticPaths = (() => TRANSLATED_LOCALES.map((lang) => ({ params: { lang } }))) satisfies GetStaticPaths;

const lang = Astro.params.lang as Locale;
---
<AppsIndex lang={lang} />
