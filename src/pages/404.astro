---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout
  route="notFound"
  title="Page not found — HomeLabCore"
  description="The page you were looking for could not be found on HomeLabCore."
>
  <section class="hero">
    <div class="container">
      <p class="eyebrow">404</p>
      <h1>Page not found</h1>
      <p class="lead">The page you were looking for does not exist or has moved.</p>
      <div class="btn-row">
        <a class="btn btn--primary" href="/">Go to the homepage</a>
        <a class="btn btn--ghost" href="/apps/">View apps</a>
      </div>
    </div>
  </section>
</BaseLayout>
