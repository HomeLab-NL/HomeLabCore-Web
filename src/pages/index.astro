---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import LabLoop from "../components/LabLoop.astro";
import ProjectCard from "../components/ProjectCard.astro";
import SectionHead from "../components/SectionHead.astro";
import { CONTACT } from "../data/site";
import { formatDate, isoDate, projectsIn } from "../lib/projects";

// Each project is presented once with a card: apps in 01, lab projects in 02.
// The hero schematic names every project but shows no images.
const apps = (await projectsIn("apps")).filter((p) => p.data.featured);
const lab = (await projectsIn("lab")).filter((p) => p.data.featured);
const benchmarks = (await getCollection("benchmarks")).sort((a, b) => b.data.published.getTime() - a.data.published.getTime());
const updates = (await getCollection("updates")).sort((a, b) => b.data.date.getTime() - a.data.date.getTime()).slice(0, 4);
---
<BaseLayout
  route="home"
  title="HomeLabCore — We build things. Then measure how we built them."
  description="HomeLabCore is an independent software lab: Android and web apps, experiments and games, and public benchmarks of AI-assisted development workflows."
  navCurrent="home"
>
  <section class="hero">
    <div class="container hero__grid">
      <div>
        <span class="eyebrow">HomeLabCore · independent software lab</span>
        <h1 class="hero__title">We build things.<br>Then measure how we built them.</h1>
        <p class="lead">HomeLabCore is an independent software lab. It makes small Android and web apps, runs experiments and games in the lab, and is preparing public benchmarks of the AI-assisted workflows behind them.</p>
        <ul class="link-list" aria-label="Explore">
          <li><span class="meta">01</span><a href="/apps/">Apps</a></li>
          <li><span class="meta">02</span><a href="/lab/">Lab</a></li>
          <li><span class="meta">03</span><a href="/benchmarks/">Benchmarks</a></li>
        </ul>
      </div>
      <LabLoop />
    </div>
  </section>

  <section class="section" aria-labelledby="apps-title">
    <div class="container">
      <SectionHead index={1} label="Apps" title="Apps" id="apps-title" link={{ href: "/apps/", text: "All apps" }}>
        Android and web apps, from closed testing to early development.
      </SectionHead>
      <div class="card-grid card-grid--2">
        {apps.map((p) => <ProjectCard project={p} sizes="(min-width: 1160px) 545px, (min-width: 720px) 50vw, 100vw" />)}
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="lab-title">
    <div class="container">
      <SectionHead index={2} label="Lab" title="From the Lab" id="lab-title" link={{ href: "/lab/", text: "All lab projects" }}>
        Infrastructure, experiments and games that are not products.
      </SectionHead>
      <div class="card-grid card-grid--2">
        {lab.map((p) => <ProjectCard project={p} sizes="(min-width: 1160px) 545px, (min-width: 720px) 50vw, 100vw" />)}
      </div>
    </div>
  </section>

  <section class="section section--tight" aria-labelledby="bench-title">
    <div class="container">
      <div class="bench-strip">
        <div>
          <span class="eyebrow">03 / Benchmarks</span>
          <h2 id="bench-title">AI workflow benchmarks</h2>
          <p class="muted">Public comparisons of Claude, Codex and Qwen on development workflows. Each run will publish its setup, method and raw data alongside the results.</p>
        </div>
        {benchmarks.length === 0 ? (
          <p class="bench-strip__status"><span class="meta">Status</span> No results published yet · <a href="/benchmarks/">How runs will be reported</a></p>
        ) : (
          <p class="bench-strip__status"><span class="meta">{formatDate(benchmarks[0].data.published)}</span> <a href={`/benchmarks/${benchmarks[0].id}/`}>{benchmarks[0].data.title}</a></p>
        )}
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="updates-title">
    <div class="container split">
      <div>
        <span class="eyebrow">04 / Log</span>
        <h2 id="updates-title">Recent updates</h2>
        <ul class="updates">
          {updates.map((u) => (
            <li>
              <time datetime={isoDate(u.data.date)}>{formatDate(u.data.date)}</time>
              <p>{u.data.href ? <a href={u.data.href}>{u.data.title}</a> : u.data.title}</p>
            </li>
          ))}
        </ul>
      </div>
      <div>
        <span class="eyebrow">About</span>
        <h2 id="about-title">About HomeLabCore</h2>
        <p class="muted">HomeLabCore is a small, independent software studio. It builds a short list of focused apps and experiments, keeps them maintained, and is clear about how each one handles your data.</p>
        <p><a href="/about">More about HomeLabCore <span aria-hidden="true">→</span></a></p>
        <dl class="meta-list">
          <dt>Support</dt>
          <dd><a href={`mailto:${CONTACT.support}`}>{CONTACT.support}</a></dd>
          <dt>Privacy</dt>
          <dd><a href={`mailto:${CONTACT.privacy}`}>{CONTACT.privacy}</a></dd>
          <dt>Help</dt>
          <dd><a href="/support/">Support pages for each app</a></dd>
        </dl>
      </div>
    </div>
  </section>
</BaseLayout>
