---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProjectRow from "../../components/ProjectRow.astro";
import SectionHead from "../../components/SectionHead.astro";
import { CONTACT } from "../../data/site";
import { projectsIn } from "../../lib/projects";

const apps = (await projectsIn("apps")).filter((p) => p.data.urls.support);
---
<BaseLayout
  route="support"
  title="Support — HomeLabCore"
  description="Support for apps published by HomeLabCore. Choose the app you need help with."
  ogDescription="Support for apps published by HomeLabCore."
  navCurrent="support"
>
  <section class="section">
    <div class="container">
      <SectionHead label="Support" title="Support" level="h1">
        Help for apps published by HomeLabCore. Choose the app you need help with.
      </SectionHead>
      <div>
        {apps.map((p) => <ProjectRow project={p} href={p.data.urls.support} summary={p.data.supportSummary} headingLevel="h2" />)}
      </div>
      <p class="muted small support-note">General questions: <a href={`mailto:${CONTACT.support}`}>{CONTACT.support}</a>. Privacy questions: <a href={`mailto:${CONTACT.privacy}`}>{CONTACT.privacy}</a>.</p>
    </div>
  </section>
</BaseLayout>
